{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src/index.ts",
    "src/engine.ts",
    "src/policy.ts",
    "src/diagnostics.ts",
    "src/diagnostics-types.ts",
    "src/inspector.ts",
    "src/inspector-fold.ts",
    "src/typert.ts"
  ]
}
